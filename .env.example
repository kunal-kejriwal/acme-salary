# Copy to .env and adjust. Never commit .env.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# Optional. Unset, development falls back to a local SQLite file (db.sqlite3),
# so the project runs with no external services. Point this at Postgres when
# you have one; production requires it.
# DATABASE_URL=postgres://acme:acme@localhost:5432/acme_salary

# --- CORS -----------------------------------------------------------------
# The Vite dev server origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
