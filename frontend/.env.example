# Copy to frontend/.env.local for local overrides.
#
# Relative on purpose. The API is reached through a same-origin proxy: the
# dev server proxies /api (vite.config.ts) and Vercel rewrites it
# (vercel.json). Pointing this at an absolute API origin reintroduces the
# cross-site cookie problem the proxy exists to avoid.
VITE_API_BASE_URL=/api/v1

# Where the dev-server proxy forwards to. Only needed if the API is not on
# the default port.
# VITE_DEV_API_ORIGIN=http://localhost:8000
